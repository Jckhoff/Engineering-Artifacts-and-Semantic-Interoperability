# ------------------------------------------------------------------
# ParameterDomainShapes.ttl
#
# SHACL shapes governing DIN EN 61360 parameter domains: logic
# interpretation / limits / units. This graph is separate from core
# policy shapes (IRI patterns, cardinalities) and is referenced by
# the CI pipeline as a blocking validation stage for all A-Box
# changes (semantic versioning X.Y.Z applies to this artifact).
#
# Source: Eckhoff et al., Section 4.6 (SHACL/OWL validation example)
# ------------------------------------------------------------------

@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix DINEN61360: <http://www.w3id.org/hsu-aut/DINEN61360#> .
@prefix VDI3682:    <http://www.w3id.org/hsu-aut/VDI3682#> .
@prefix unece:      <http://www.hsu-hh.de/aut/ontologies/unece#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex:         <http://example.org/shapes#> .
@prefix parx:       <http://www.hsu-hh.de/aut/ParX#> .

# ---------------------------------------------------------------
# Type_Description: must exist (targetClass) and must carry at
# least one rdf:type drawn from the controlled UNECE unit
# vocabulary. Uses a SPARQL existence check because a
# Type_Description legitimately has multiple rdf:type values
# (its own class DINEN61360:Type_Description plus a UNECE unit).
# ---------------------------------------------------------------
ex:TypeDescription_Shape
    a sh:NodeShape ;
    sh:targetClass DINEN61360:Type_Description ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Type_Description must declare at least one rdf:type from the UNECE unit vocabulary." ;
        sh:select "PREFIX unece: <http://www.hsu-hh.de/aut/ontologies/unece#> SELECT $this WHERE { FILTER NOT EXISTS { $this a ?u . FILTER ( ?u IN ( unece:CEL , unece:NEW , unece:MTS , unece:WTT , unece:MTR , unece:28 , unece:kVA ) ) } }" ;
    ] .

# ---------------------------------------------------------------
# Instance_Description: Expression_Goal, Logic_Interpretation and
# Value must be present and drawn from the controlled vocabulary.
# ---------------------------------------------------------------
ex:InstanceDescription_Shape
    a sh:NodeShape ;
    sh:targetClass DINEN61360:Instance_Description ;

    sh:property [
        a sh:PropertyShape ;
        sh:path DINEN61360:Expression_Goal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:hasValue "Requirement" ;
        sh:message "Expression_Goal must be 'Requirement'." ;
    ] ;

    sh:property [
        a sh:PropertyShape ;
        sh:path DINEN61360:Logic_Interpretation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( ">=" "<=" ">" "<" "=" ) ;
        sh:message "Logic_Interpretation must be one of: >=, <=, >, <, =, IN." ;
    ] ;

    sh:property [
        a sh:PropertyShape ;
        sh:path DINEN61360:Value ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Instance_Description must have 'Value'." ;
    ] .

# ---------------------------------------------------------------
# Data_Element (base class): at least one Type_Description
# reference and at least one Instance_Description. The
# has_Type_Description value may EITHER be a proper
# DINEN61360:Type_Description instance OR a direct UNECE unit code
# IRI (shorthand pattern present in the static A-Box).
# ---------------------------------------------------------------
ex:DataElement_Shape
    a sh:NodeShape ;
    sh:targetClass DINEN61360:Data_Element ;

    sh:property [
        a sh:PropertyShape ;
        sh:path DINEN61360:has_Type_Description ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class DINEN61360:Type_Description ]
            [ sh:in ( unece:CEL unece:NEW unece:MTS unece:WTT unece:MTR unece:28 unece:kVA ) ]
        ) ;
        sh:message "Data_Element must have at least one Type_Description or a direct UNECE unit reference." ;
    ] ;

    sh:property [
        a sh:PropertyShape ;
        sh:path DINEN61360:has_Instance_Description ;
        sh:minCount 1 ;
        sh:class DINEN61360:Instance_Description ;
        sh:message "Data_Element must have at least one Instance_Description." ;
    ] .

# ---------------------------------------------------------------
# parx:Restriction (common base shape): shared structural rules for
# all restriction-typed Data_Elements, regardless of whether they are
# a LimitRestriction or a RangeRestriction. SHACL does not
# auto-inherit targets across rdfs:subClassOf, so rules are restated
# explicitly here and specialized further below.
# ---------------------------------------------------------------
ex:Restriction_Shape
    a sh:NodeShape ;
    sh:targetClass parx:Restriction ;

    sh:property [
        a sh:PropertyShape ;
        sh:path DINEN61360:has_Type_Description ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class DINEN61360:Type_Description ]
            [ sh:in ( unece:CEL unece:NEW unece:MTS unece:WTT unece:MTR unece:28 unece:kVA ) ]
        ) ;
        sh:message "Restriction must have at least one Type_Description or a direct UNECE unit reference." ;
    ] ;

    sh:property [
        a sh:PropertyShape ;
        sh:path DINEN61360:has_Instance_Description ;
        sh:minCount 1 ;
        sh:class DINEN61360:Instance_Description ;
        sh:message "Restriction must have at least one Instance_Description." ;
    ] .

# ---------------------------------------------------------------
# parx:LimitRestriction: exactly one directed single-sided bound
# (Logic_Interpretation in {<=, <, >=, >}). Represents a single
# limit rather than a paired interval.
# ---------------------------------------------------------------
ex:LimitRestriction_Shape
    a sh:NodeShape ;
    sh:targetClass parx:LimitRestriction ;

    sh:property [
        a sh:PropertyShape ;
        sh:path DINEN61360:has_Instance_Description ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class DINEN61360:Instance_Description ;
        sh:message "LimitRestriction must have exactly one Instance_Description (a single directed bound)." ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "LimitRestriction's Instance_Description must use a single-sided Logic_Interpretation (<=, <, >=, or >), not '='." ;
        sh:select "PREFIX DINEN61360: <http://www.w3id.org/hsu-aut/DINEN61360#> SELECT $this WHERE { $this a <http://www.hsu-hh.de/aut/ParX#LimitRestriction> . $this DINEN61360:has_Instance_Description ?id . ?id DINEN61360:Logic_Interpretation ?li . FILTER ( ?li NOT IN ( \"<=\" , \"<\" , \">=\" , \">\" ) ) }" ;
    ] .

# ---------------------------------------------------------------
# parx:RangeRestriction: requires a paired lower (>=) and upper (<=)
# bound across at least two Instance_Description individuals.
# Enforced via a SPARQL-based SHACL constraint (range-pairing rule).
# ---------------------------------------------------------------
ex:RangeRestriction_Shape
    a sh:NodeShape ;
    sh:targetClass parx:RangeRestriction ;

    sh:property [
        a sh:PropertyShape ;
        sh:path DINEN61360:has_Instance_Description ;
        sh:minCount 2 ;
        sh:class DINEN61360:Instance_Description ;
        sh:message "RangeRestriction must have at least two Instance_Description individuals (lower and upper bound)." ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "RangeRestriction must have one Instance_Description with '>=' (min) and one with '<=' (max)." ;
        sh:select "PREFIX DINEN61360: <http://www.w3id.org/hsu-aut/DINEN61360#> PREFIX parx: <http://www.hsu-hh.de/aut/ParX#> SELECT $this WHERE { $this a parx:RangeRestriction . FILTER NOT EXISTS { $this DINEN61360:has_Instance_Description ?idMin . ?idMin DINEN61360:Logic_Interpretation \">=\" . $this DINEN61360:has_Instance_Description ?idMax . ?idMax DINEN61360:Logic_Interpretation \"<=\" . } }" ;
    ] .

# ---------------------------------------------------------------
# TechnicalResource: must reference at least one Data_Element.
# ---------------------------------------------------------------
ex:TechnicalResource_Shape
    a sh:NodeShape ;
    sh:targetClass VDI3682:TechnicalResource ;
    sh:property [
        a sh:PropertyShape ;
        sh:path DINEN61360:has_Data_Element ;
        sh:minCount 1 ;
        sh:class DINEN61360:Data_Element ;
        sh:message "TechnicalResource must have at least one Data_Element." ;
    ] .
